{
    "analyser": "@abs_builddir@/../../analyser-gt-norm.hfstol",
    "generator": "@abs_builddir@/../../generator-gt-norm.hfstol",
    "lexcroot": "@abs_srcdir@/../root.lexc",
    "nouns": {
        "lexcfile": "@abs_srcdir@/../stems/nouns.lexc",
        "lemmatags": ["+N+Sg+Nom", "+N+Pl+Nom", "+N+Coll+Sg+Nom", "+N+NomAg+Sg+Nom", "+N+Dimin+Sg+Nom"],
        "exclusions": ["(CmpN/Only|ShCmp|\\+Cmp/SplitR| Rreal | R | RHyph | Rnoun |\\+V\\+| AGAdj|NOT-TO-LEMMATEST)"]
    },
    "adjectives": {
        "lexcfile": "@abs_srcdir@/../stems/adjectives.lexc",
        "lemmatags": ["+A+Sg+Nom", "+A+Attr"]
    },
    "propernouns": {
        "lexcfile": "@abs_srcdir@/../stems/propernouns.lexc",
        "lemmatags": ["+N+Prop+Sg+Nom", "+N+Prop+Pl+Nom"]
    },
    "verbs": {
        "lexcfile": "@abs_srcdir@/../stems/verbs.lexc",
        "lemmatags": ["+V+Inf"],
        "exclusions": ["(\\+Neg|AB-DO|V-NEG_IJ)"]
    },
    "otherlexcs": [
        "@abs_srcdir@/../stems/abbreviations.lexc",
        "@abs_srcdir@/../stems/exceptions.lexc",
        "@abs_srcdir@/../stems/numerals.lexc",
        "@abs_srcdir@/../stems/pronouns.lexc",
        "@abs_srcdir@/../affixes/adjectives.lexc",
        "@abs_srcdir@/../affixes/nouns.lexc",
        "@abs_srcdir@/../affixes/propernouns.lexc",
        "@abs_srcdir@/../affixes/symbols.lexc",
        "@abs_srcdir@/../affixes/verbs.lexc",
        "@abs_srcdir@/../compounding.lexc",
        "@abs_srcdir@/../clitics.lexc",
        "@abs_builddir@/../generated_files/smi-sms-arabic_roman_digits.lexc",
        "@abs_builddir@/../generated_files/smi-sms-digits.lexc",
        "@abs_builddir@/../generated_files/mul-sms-punctuation.lexc",
        "@abs_builddir@/../generated_files/mul-sms-symbols.lexc"
    ]
}
